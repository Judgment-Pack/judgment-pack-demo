# Where your packs live. This directory is mounted as the sandbox's file-browser
# root; every folder inside it is a project the agent can open. The default is
# this repo's seed projects; point it at any directory you prefer.
PACKS_DIR=./projects

# Pinned versions. The drift CI exercises exactly these.
AGENT_CANVAS_VERSION=1.6.1
JUDGMENT_PACK_VERSION=0.9.0

# Linux/WSL only: set to your `id -u` / `id -g` if they are not 1000, so the
# sandbox user matches you and files it writes are yours. Ignored elsewhere.
HOST_UID=1000
HOST_GID=1000
