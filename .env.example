# Where your packs live. This directory is mounted as the sandbox's file-browser
# root; every folder inside it is a project the agent can open. The default is
# this repo's seed projects; point it at any directory you prefer — but never
# at this repo's root or any ancestor of gateway-state/: that would mount the
# attestation signing seed read-write into the sandbox and void the desk's
# trust boundary (attestation/README.md).
PACKS_DIR=./projects

# Pinned versions. The drift CI exercises exactly these.
AGENT_CANVAS_VERSION=1.6.1
JUDGMENT_PACK_VERSION=0.13.0

# Linux/WSL only: set to your `id -u` / `id -g` if they are not 1000, so the
# sandbox user matches you and files it writes are yours. Ignored elsewhere.
HOST_UID=1000
HOST_GID=1000

# The attested-screening desk. The gateway (research-preview reference) and
# the derivation rule have no release channels yet, so both are pinned by
# commit and built from source during `docker compose build`. The drift CI
# exercises exactly these.
GATEWAY_REF=3a9f8a89dbb2a87ebdc25155afe5ea90d2185498
DERIVATION_REF=6f5500fb8e61014632f9b4b85e9ce68fcebf0e39

# The authority label receipts are signed under and the verifier requires.
# Both compose services read this one variable; if the two sides ever
# disagree, every screening degrades to unknown (authority-mismatch).
GATEWAY_AUTHORITY=gateway:enterprise-demo
